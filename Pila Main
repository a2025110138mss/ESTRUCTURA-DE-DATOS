#include <iostream>
#include "Pila.h"
using namespace std;

void mostrarMenu() {
    cout << "\n===== MENU PILA =====\n";
    cout << "1. Apilar elemento\n";
    cout << "2. Desapilar elemento\n";
    cout << "3. Ver cima\n";
    cout << "4. Ver pila completa\n";
    cout << "5. Verificar si esta vacia\n";
    cout << "6. Limpiar pila\n";
    cout << "7. Salir\n";
    cout << "Seleccione una opcion: ";
}

int main()
{
    Pila p;
    int opcion;
    int elemento;

    do {
        mostrarMenu();
        cin >> opcion;

        switch (opcion) {
        case 1:
            cout << "Ingrese elemento: ";
            cin >> elemento;
            if (p.Apilar(elemento))
                cout << "Apilado correctamente\n";
            break;

        case 2:
            if (p.Desapilar())
                cout << "Desapilado correctamente\n";
            break;

        case 3:
            if (p.CimaPila(elemento))
                cout << "Cima: " << elemento << endl;
            break;

        case 4:
            cout << "Contenido de la pila:\n";
            p.VerPila();
            break;

        case 5:
            if (p.PilaVacia())
                cout << "La pila esta vacia\n";
            else
                cout << "La pila NO esta vacia\n";
            break;

        case 6:
            p.LimpiarPila();
            cout << "Pila limpiada\n";
            break;

        case 7:
            cout << "Saliendo...\n";
            break;

        default:
            cout << "Opcion invalida\n";
        }

    } while (opcion != 7);

    return 0;
}

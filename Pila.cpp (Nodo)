#include <iostream>
#include <string>
#include "Pila.h"
#include "Nodo.h"
using namespace std;

Pila::Pila() {
    inicio = NULL;
}

void Pila::push() {
    int valor;
    string valor2;

    Nodo* aux = new Nodo(0, ""); 

    system("cls");
    cout << "Ingresa el id del proceso: ";
    cin >> valor;

    cout << "Ingresa el nombre del proceso: ";
    cin.ignore();
    getline(cin, valor2);

    aux->dato = valor;
    aux->nombre = valor2;
    aux->sig = NULL;

    if (inicio != NULL)
        aux->sig = inicio;

    inicio = aux;

    cout << "Nuevo proceso insertado en la pila!\n";
    system("pause");
}

void Pila::pop() {
    if (inicio == NULL) {
        system("cls");
        cout << "\nLa pila esta vacia!\n\n";
        system("pause");
    }
    else {
        Nodo* temp = inicio; 
        inicio = inicio->sig;

        system("cls");
        cout << "\nEl proceso eliminado es: "
            << temp->dato << " - " << temp->nombre << "\n";

        delete temp;
        system("pause");
    }
}

void Pila::show() {
    Nodo* aux1 = inicio;

    if (inicio == NULL) {
        system("cls");
        cout << "\nLa pila esta vacia!\n\n";
    }
    else {
        system("cls");
        cout << "Procesos:\n" << endl;

        while (aux1 != NULL) {
            cout << aux1->dato << " - " << aux1->nombre << "\n";
            aux1 = aux1->sig;
        }
    }
    system("pause");
}

void Pila::top() {
    if (inicio == NULL) {
        system("cls");
        cout << "\nLa pila esta vacia!\n\n";
    }
    else {
        system("cls");
        cout << "Proceso TOP:\n\n";
        cout << inicio->dato << " - " << inicio->nombre << "\n";
    }
    system("pause");
}

void Pila::size() {
    Nodo* aux1 = inicio;
    int contador = 0;

    while (aux1 != NULL) {
        contador++;
        aux1 = aux1->sig;
    }

    system("cls");
    cout << "El tamano de la pila es: " << contador << endl;
    system("pause");
}
